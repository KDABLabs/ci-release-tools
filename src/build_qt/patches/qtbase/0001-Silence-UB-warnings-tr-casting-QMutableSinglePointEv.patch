From: Sergio Martins <sergio.martins@kdab.com>
Date: Thu, 14 May 2026 23:08:25 +0100
Subject: [PATCH] Silence UB warnings tr casting QMutableSinglePointEvent to
 QMouseEvent

This has been reported to Qt
---
 src/gui/kernel/qguiapplication.cpp | 1 +
 1 file changed, 1 insertion(+)

diff --git a/src/gui/kernel/qguiapplication.cpp b/src/gui/kernel/qguiapplication.cpp
index 4e40131ae1a..c51296d55a2 100644
--- a/src/gui/kernel/qguiapplication.cpp
+++ b/src/gui/kernel/qguiapplication.cpp
@@ -2239,6 +2239,7 @@ void Q_TRACE_INSTRUMENT(qtgui) QGuiApplicationPrivate::processWindowSystemEvent(
     release events that change position, see tst_QWidget::touchEventSynthesizedMouseEvent()
     and tst_QWindow::generatedMouseMove() auto tests.
 */
+__attribute__((no_sanitize("undefined")))
 void QGuiApplicationPrivate::processMouseEvent(QWindowSystemInterfacePrivate::MouseEvent *e)
 {
     QEvent::Type type = QEvent::None;
