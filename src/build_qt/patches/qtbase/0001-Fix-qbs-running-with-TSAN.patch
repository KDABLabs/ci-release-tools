From 9314a1af13de1413c28d78ce919fb2aa55aa8c0f Mon Sep 17 00:00:00 2001
From: Sergio Martins <sergio.martins@kdab.com>
Date: Fri, 15 May 2026 01:09:44 +0100
Subject: [PATCH] Fix qbs running with TSAN

It would crash with an assert inside TSAN
---
 src/corelib/io/qprocess_unix.cpp | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/src/corelib/io/qprocess_unix.cpp b/src/corelib/io/qprocess_unix.cpp
index e09ee7f8177..968d778e734 100644
--- a/src/corelib/io/qprocess_unix.cpp
+++ b/src/corelib/io/qprocess_unix.cpp
@@ -476,6 +476,10 @@ void QProcessPrivate::startProcess()
 #if defined(__SANITIZE_ADDRESS__) || __has_feature(address_sanitizer)
     // ASan writes to global memory, so we mustn't use vfork().
     ffdflags |= FFD_USE_FORK;
+#endif
+#if defined(__SANITIZE_THREAD__) || __has_feature(thread_sanitizer)
+    // TSan's clone() interceptor crashes in ForkAfter/FindSlotAndLock.
+    ffdflags |= FFD_USE_FORK;
 #endif
     if (unixExtras && unixExtras->childProcessModifier)
         ffdflags |= FFD_USE_FORK;
-- 
2.43.0

